@model TvShow

@{
    ViewData["Title"] = "Edit TV Show";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card serial-card shadow-lg p-4">
                <h2 class="text-light fw-bold mb-3">Edit TV Show</h2>
                <div class="header-divider mb-4"></div>

                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label text-light fw-semibold"></label>
                        <input asp-for="Title" class="form-control bg-dark text-light border-secondary" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Showrunner" class="form-label text-light fw-semibold"></label>
                            <input asp-for="Showrunner" class="form-control bg-dark text-light border-secondary" />
                            <span asp-validation-for="Showrunner" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Premiere" class="form-label text-light fw-semibold"></label>
                            <input asp-for="Premiere" type="date" class="form-control bg-dark text-light border-secondary" />
                            <span asp-validation-for="Premiere" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Genre" class="form-label text-light fw-semibold"></label>
                        <input asp-for="Genre" class="form-control bg-dark text-light border-secondary" />
                        <span asp-validation-for="Genre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light fw-semibold">New Poster Image (Optional)</label>
                        <input type="file" name="posterFile" accept="image/*" class="form-control bg-dark text-light border-secondary" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label text-light fw-semibold"></label>
                        <textarea asp-for="Description" rows="4" class="form-control bg-dark text-light border-secondary"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}