@model IEnumerable<TvShow>

@{
    ViewData["Title"] = "Best TV Shows of All Time";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 header-section">
        <div>
            <h1 class="display-5 fw-bold text-light">Best TV Show</h1>
            <p class="lead text-secondary text-light">The greatest television series ranked by personal choice</p>
            <div class="header-divider w-100"></div>
        </div>
        <a asp-action="Create" class="btn btn-danger btn-lg rounded-pill px-4 shadow">
            <i class="bi bi-plus-lg me-2"></i>Add New Show
        </a>
    </div>


    <!-- TV Show Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var show in Model)
            {
                <div class="col">
                    <div class="card h-100 serial-card border-0 shadow-sm">
                        <!-- Poster -->
                        <div class="card-img-wrapper">
                            <img src="@show.Poster" class="card-img-top" alt="@show.Title" loading="lazy">
                            <span class="badge badge-genre">@show.Genre</span>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge badge-year">@show.Premiere.ToString("yyyy")</span>
                                <small class="text-muted creator-text">
                                    <i class="bi bi-camera-reels me-1"></i>@show.Showrunner
                                </small>
                            </div>

                            <h5 class="card-title text-light fw-bold mb-3">@show.Title</h5>
                            <p class="card-text text-secondary description-text flex-grow-1">
                                @show.Description
                            </p>

                            <div class="mt-auto d-flex gap-2 pt-2 border-top border-secondary border-opacity-25">
                                <a asp-action="Details" asp-route-id="@show.Id" class="btn btn-outline-light btn-sm flex-grow-1">
                                    <i class="bi bi-info-circle me-1"></i>Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@show.Id" class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@show.Id" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-secondary py-5">
                <h4>No TV shows found</h4>
            </div>
        }
    </div>
</div>